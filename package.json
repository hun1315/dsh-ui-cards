{
  "name": "dsh-ui-cards",
  "description": "UI验牌：把 DSH 右上角「⋯ 更多操作」改造成卡牌式插件扩展坞——插件前端 UI 收容成可滑动卡牌，点卡即开；带皮肤系统、换牌音效与悬浮注释。",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "ui",
    "cards",
    "dock",
    "carousel",
    "tarot"
  ],
  "author": "hun1315",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hun1315/dsh-ui-cards.git"
  },
  "bugs": {
    "url": "https://github.com/hun1315/dsh-ui-cards/issues"
  },
  "homepage": "https://github.com/hun1315/dsh-ui-cards#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
